#include "raylib.h"

int main()
{
    float posX = -100;
    
    Texture2D feliz;
    Sound acerto;
    Sound fundo;
    
    InitWindow (800, 450, "Meu Primeiro Game");
    
    InitAudioDevice();
    
    
    feliz = LoadTexture ("feliz.png");
    acerto = LoadSound ("acerto.mp3");
    fundo = LoadSound ("fundo.ogg");
    
    PlaySound(fundo);

    while (!WindowShouldClose())
    {
        posX += GetFrameTime () * 300;
        
       if (posX > 800)
       {
          posX = -100;
          PlaySound(acerto);
       }
       

        BeginDrawing();

        ClearBackground(RAYWHITE);

        DrawTexture(feliz, posX, 10, WHITE);
        
        
        DrawFPS (10, 10);

        EndDrawing();
    }
    
    UnloadSound (acerto);
    
    UnloadSound (fundo);
    
    CloseAudioDevice();
    
    CloseWindow();

    return 0;
}
