#include "raylib.h"

int main()
{
    Texture2D feliz;
    Texture2D inimigo;

    InitWindow(800, 450, "Meu Primeiro Game");

    feliz = LoadTexture ("feliz.png");
    inimigo = LoadTexture ("inimigo.png");

    while (!WindowShouldClose())
    {


        BeginDrawing();

        ClearBackground(RAYWHITE);

        DrawTexture(feliz, 10, 10, WHITE);
        DrawTexture(inimigo, 200, 30, RED);
        

        EndDrawing();
    }

    CloseWindow();

    return 0;
}
